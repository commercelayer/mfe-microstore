{
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "preview": "pnpm -r preview",
    "check": "pnpm -r check",
    "check:fix": "pnpm -r check:fix",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "clean": "pnpm dlx rimraf --glob **/node_modules **/pnpm-lock.yaml",
    "dep:major": "pnpm dlx npm-check-updates --packageFile '**/package.json' -u",
    "dep:semver": "pnpm dlx npm-check-updates --packageFile '**/package.json' -u -t semver"
  },
  "keywords": [],
  "author": {
    "name": "Matteo Alessani",
    "email": "matteo@commercelayer.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/commercelayer/monorepo-starter.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=7"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "lerna": "^10.0.1"
  }
}
