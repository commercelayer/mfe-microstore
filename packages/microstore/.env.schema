# Environment for mfe-microstore, loaded by varlock (https://varlock.dev).
#
# Only the Playwright e2e tests load this file (see playwright.config.ts). Vite
# does not: the dev server and the build keep reading `.env.local` and the
# process environment directly, so building or self-hosting the app never
# needs AWS access. When the e2e tests start the dev server, it inherits the
# variables resolved here.
#
# Secrets are kept in a single AWS Systems Manager Parameter Store parameter per
# project, whose value is a JSON object keyed by variable name:
#
#   {
#     "E2E_CLIENT_ID": "...",
#     "E2E_DOMAIN": "...",
#     "E2E_MARKET_ID": "...",
#     "E2E_SKU_LIST_ID": "...",
#     "E2E_SKU_LIST_ID_WITH_GROUPED_VARIANTS": "...",
#     "E2E_EMPTY_SKU_LIST_ID": "..."
#   }
#
# Each secret below reads one key out of that parameter with awsParam().
# Credentials come from the default AWS chain (AWS_PROFILE, SSO session,
# access keys, ...); the caller needs ssm:GetParameter on the parameter.
# Values set in `.env.local` or in the process environment (e.g. the CircleCI
# context) take precedence over this file, so CI needs no AWS access.
#
# @defaultSensitive=false
# @defaultRequired=infer
# @generateTsTypes(path=specs/env.d.ts, importMetaEnv=none, processEnv=none)
# @plugin(@varlock/aws-secrets-plugin)
# @initAws(region=eu-west-1)
# ---

# Parameter Store parameter holding this project's secrets.
# @internal
AWS_SSM_PARAMETER=/dev/mfe-microstore

# --- App (dev server and build) ---

# Sub-path the app is served from, without leading or trailing slash.
# With `microstore` the app lives at `/microstore/` (Vite `base` and router
# base). The e2e tests visit `/microstore/...` URLs, so they need this value.
# @optional
PUBLIC_PROJECT_PATH=microstore

# Set to `true` to generate the bundle size report (rollup-plugin-visualizer)
# during the build.
# @type=boolean @optional
ANALYZE_BUNDLE=

# Slug of your Commerce Layer organization, needed when the app is self-hosted.
# When set, it always overrides `selfHostedSlug` from `window.clAppConfig`.
# @optional
PUBLIC_SELF_HOSTED_SLUG=

# --- E2E tests (Playwright) ---
# Only read by the tests in `specs/`, never exposed to the browser bundle.

# Sales channel application client ID, used to get the access token the
# tests pass to the microstore page.
# @sensitive
E2E_CLIENT_ID=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_CLIENT_ID")

# Commerce Layer domain used for authentication (for example
# `commercelayer.io`). The app reads the API domain from the token issuer.
E2E_DOMAIN=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_DOMAIN")

# Token scope used to authenticate the tests, passed as-is to the auth API
# (for example `market:code:EU`).
E2E_MARKET_ID=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_MARKET_ID")

# Manual SKU list whose first item has quantity 12.
E2E_SKU_LIST_ID=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_SKU_LIST_ID")

# Manual SKU list with variants grouped by `sku.reference`.
E2E_SKU_LIST_ID_WITH_GROUPED_VARIANTS=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_SKU_LIST_ID_WITH_GROUPED_VARIANTS")

# Manual SKU list with no items.
E2E_EMPTY_SKU_LIST_ID=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_EMPTY_SKU_LIST_ID")
