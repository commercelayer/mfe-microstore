{
  "name": "microstore",
  "version": "5.3.2",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=7"
  },
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "vite preview",
    "check": "pnpm biome check src",
    "check:fix": "pnpm biome check src --write",
    "ts:check": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "touch ./public/config.local.js"
  },
  "keywords": [
    "reactjs",
    "vitejs",
    "jamstack",
    "headless",
    "ecommerce",
    "api",
    "microstore",
    "store",
    "commercelayer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commercelayer/mfe-microstore.git"
  },
  "author": {
    "name": "Commerce Layer",
    "email": "development@commercelayer.io"
  },
  "bugs": {
    "url": "https://github.com/commercelayer/mfe-microstore/issues"
  },
  "homepage": "https://github.com/commercelayer/mfe-microstore#readme",
  "license": "MIT",
  "dependencies": {
    "@commercelayer/js-auth": "^8.0.1",
    "@commercelayer/react-components": "^5.0.6",
    "@commercelayer/sdk": "^8.0.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/async-retry": "^1.4.9",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "async-retry": "^1.3.3",
    "autoprefixer": "^10.6.1",
    "i18next": "^26.4.2",
    "jsdom": "^30.1.2",
    "jwt-decode": "^4.0.0",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.16",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "dotenv": "^18.0.6"
  }
}
